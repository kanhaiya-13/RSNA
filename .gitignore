desktop.ini
ehthumbs.db

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── torch.compile / triton cache ──────────────────────────────────────────────
__torch_compile_debug/
.triton/

