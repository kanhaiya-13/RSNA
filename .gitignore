outputs*/**/*.pth
outputs*/**/*.ckpt

# ── Logs & Checkpoints ────────────────────────────────────────────────────────
*.log
.ipynb_checkpoints/
*.ipynb
wandb/
runs/

# ── Data & Cache (never commit raw datasets or memmaps) ────────────────────────
*.npz
*.npy
*.parquet
*.feather
.cache/
cache/
rsna_cache/

# Ignore root/raw data CSVs, but allow tracking metrics, folds, and history CSVs
*.csv
!requirements*.txt
!outputs*/**/*.csv
!outputs*/*.csv
!training_history*.csv

# ── IDE & editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

