# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Model checkpoints & large binary artifacts ────────────────────────────────
*.pt
*.pth
*.ckpt
*.bin
*.h5
*.onnx
