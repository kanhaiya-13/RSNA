# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Model checkpoints & large binary artifacts ────────────────────────────────
*.pt
*.pth
*.ckpt
*.bin
outputs/*.pt
outputs/*.pth

# ── Logs & Checkpoints ────────────────────────────────────────────────────────
*.log
.ipynb_checkpoints/
*.ipynb

# ── Data (never commit raw datasets) ──────────────────────────────────────────
*.npz
*.npy
*.csv
!outputs/*.csv
!requirements*.txt        # keep requirements CSVs if any

